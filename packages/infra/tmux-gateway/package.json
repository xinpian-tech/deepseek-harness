{
  "name": "@dsh-fleet/tmux-gateway",
  "description": "Cross-machine tmux: a TCP-to-unix-socket bridge that exposes one machine's tmux server to the fleet",
  "version": "0.1.7-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
