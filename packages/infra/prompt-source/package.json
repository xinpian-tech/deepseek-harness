{
  "name": "@dsh-fleet/prompt-source",
  "description": "Prompt-source labelling for the fleet: a request-scoped source registry, a source-carrying prompt path, and the durable prompt/source audit record",
  "version": "0.1.7-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
